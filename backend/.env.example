# VARSHA Backend Environment Configuration
ENVIRONMENT=development
API_V1_STR=/api/v1

# Permitted CORS origins for API access.
# Comma-separated or JSON list. Default allows local Vite dev server.
# For production deployment, set to specific origin(s), e.g. https://varsha.example.com
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "https://varsha-dun.vercel.app"]

# NDMA SACHET Disaster Alert Feed Settings
# Default: Nationwide all-India feed. Maharashtra feed: https://sachet.ndma.gov.in/cap_public_website/rss/rss_maharashtra.xml
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
SACHET_REQUEST_TIMEOUT_SECONDS=10.0
SACHET_CACHE_TTL_SECONDS=300
SACHET_MAX_ALERTS_PER_FETCH=20

# Open-Meteo Rainfall Settings
# Free tier requires no API key (CC BY 4.0 attribution required).
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_REQUEST_TIMEOUT_SECONDS=10.0
OPEN_METEO_CACHE_TTL_SECONDS=900
OPEN_METEO_MAX_FORECAST_HOURS=72

# Redis Weather Snapshot Cache & Scheduler Settings
# Managed Redis connection string (e.g. Render Key Value internal/external URL: rediss://default:pwd@host:port)
REDIS_URL=
REDIS_CONNECT_TIMEOUT_SECONDS=3.0
WEATHER_REFRESH_INTERVAL_MINUTES=30
WEATHER_SNAPSHOT_STALE_AFTER_MINUTES=35
WEATHER_SNAPSHOT_TTL_SECONDS=86400
WEATHER_SCHEDULER_ENABLED=true
WEATHER_SUPPORTED_REGION=navi_mumbai
WEATHER_MAX_CELL_DISTANCE_KM=15.0

# Geoapify Geocoding API Settings
# Keep this key confidential on the backend; never expose in frontend code or commits.
# For local development: copy .env.example to .env and set your key:
# GEOAPIFY_API_KEY=your_api_key_here
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v1/geocode/autocomplete
GEOAPIFY_REQUEST_TIMEOUT_SECONDS=8.0
GEOAPIFY_CACHE_TTL_SECONDS=300
GEOAPIFY_DEFAULT_LIMIT=5
GEOAPIFY_MAX_LIMIT=20
# Default geographic proximity bias centered on Navi Mumbai [lon,lat]
GEOAPIFY_BIAS_PROXIMITY=73.0297,19.0330
# Optional country restriction: 'in' for India; set empty to search globally
GEOAPIFY_COUNTRY_FILTER=in
