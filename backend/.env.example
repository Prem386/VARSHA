# VARSHA Backend Environment Configuration
ENVIRONMENT=development
API_V1_STR=/api/v1

# Permitted CORS origins for API access.
# Comma-separated or JSON list. Default allows local Vite dev server.
# For production deployment, set to specific origin(s), e.g. https://varsha.example.com
CORS_ORIGINS=["http://localhost:5173"]

# NDMA SACHET Disaster Alert Feed Settings
# Default: Nationwide all-India feed. Maharashtra feed: https://sachet.ndma.gov.in/cap_public_website/rss/rss_maharashtra.xml
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
SACHET_REQUEST_TIMEOUT_SECONDS=10.0
SACHET_CACHE_TTL_SECONDS=300
SACHET_MAX_ALERTS_PER_FETCH=20

# Open-Meteo Rainfall Settings
# Free tier requires no API key (CC BY 4.0 attribution required).
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_REQUEST_TIMEOUT_SECONDS=10.0
OPEN_METEO_CACHE_TTL_SECONDS=900
OPEN_METEO_MAX_FORECAST_HOURS=72
