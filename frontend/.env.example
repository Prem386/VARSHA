# VARSHA Frontend Environment Configuration

# Backend API base URL (e.g. for Render production deployment).
# Leave empty in local development to use the Vite dev proxy to http://localhost:8000.
# In production on Vercel, set to your deployed Render service URL:
# Example: VITE_API_BASE_URL=https://varsha-api.onrender.com
VITE_API_BASE_URL=

# OSRM Driving Router URL (defaults to public demo server).
# Optional: override if using a custom or self-hosted OSRM instance.
VITE_OSRM_ROUTER_URL=https://router.project-osrm.org
